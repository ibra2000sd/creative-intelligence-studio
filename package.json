{
  "name": "creative-intelligence-studio-repo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Source repository for the Creative Intelligence Studio Claude Code plugin, its demos, tests and documentation.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "cs": "node plugin/cli/main.mjs",
    "test": "node --test \"tests/unit/*.test.mjs\" \"tests/integration/*.test.mjs\" \"tests/security/*.test.mjs\"",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.mjs\"",
    "validate:plugin": "claude plugin validate ./plugin && claude plugin validate ."
  },
  "devDependencies": {
    "@fontsource/fraunces": "^5.2.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.2.0",
    "@fontsource/instrument-sans": "^5.2.0",
    "@fontsource/jetbrains-mono": "^5.2.0",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "axe-core": "4.14.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "harfbuzzjs": "1.6.4",
    "meshoptimizer": "1.3.0",
    "opentype.js": "1.3.4",
    "playwright-core": "1.65.0",
    "sharp": "0.35.5",
    "svgo": "4.1.0"
  }
}

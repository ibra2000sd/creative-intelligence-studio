{
  "schemaVersion": "1.0.0",
  "projectId": "haldora-launch",
  "dnaRevision": 1,
  "motions": [
    { "id": "hero-entrance", "surface": "marketing", "target": "Hero copy lines", "intent": "orientation", "trigger": "load", "frequency": "once", "properties": ["transform", "opacity"], "interruptible": false, "decision": "animate", "runtime": "css", "duration": "cinematic", "easing": "enter", "reducedMotionFallback": "crossfade", "keyboardEquivalent": true, "rationale": "A single staggered rise on first load establishes reading order; it never replays.", "status": "verified" },
    { "id": "hero-parallax", "surface": "marketing", "target": "Hero landscape planes", "intent": "storytelling", "trigger": "scroll", "frequency": "once", "properties": ["transform"], "interruptible": true, "decision": "animate", "runtime": "gsap-scrolltrigger", "duration": "scrubbed", "easing": "linear", "reducedMotionFallback": "static-composition", "keyboardEquivalent": true, "rationale": "Planes drift at different rates to give the horizon depth; wide screens only, a single composed image elsewhere.", "status": "verified" },
    { "id": "story-sun", "surface": "marketing", "target": "Sun on the day arc and chapter frames", "intent": "storytelling", "trigger": "scroll", "frequency": "once", "properties": ["transform", "opacity"], "interruptible": true, "decision": "animate", "runtime": "gsap-scrolltrigger", "duration": "scrubbed", "easing": "linear", "reducedMotionFallback": "crossfade", "keyboardEquivalent": true, "rationale": "The signature: scroll position is time of day. Scrubbed, reversible, and the chapters remain a plain readable list without it.", "status": "verified" },
    { "id": "section-reveal", "surface": "marketing", "target": "Section headings and cards", "intent": "orientation", "trigger": "in-view", "frequency": "once", "properties": ["transform", "opacity"], "interruptible": false, "decision": "animate", "runtime": "css", "duration": "slow", "easing": "enter", "reducedMotionFallback": "remove", "keyboardEquivalent": true, "rationale": "One short rise as a section first enters, so the eye lands on its heading.", "status": "verified" },
    { "id": "stat-count", "surface": "marketing", "target": "Chapter statistics", "intent": "explanation", "trigger": "in-view", "frequency": "once", "properties": ["opacity"], "interruptible": false, "decision": "animate", "runtime": "waapi", "duration": "cinematic", "easing": "enter", "reducedMotionFallback": "remove", "keyboardEquivalent": true, "rationale": "Counting up once draws attention to the single number each chapter is about; implemented with requestAnimationFrame, no library.", "status": "verified" },
    { "id": "card-hover", "surface": "marketing", "target": "Feature cards", "intent": "feedback", "trigger": "hover", "frequency": "occasional", "properties": ["transform", "opacity"], "interruptible": true, "decision": "animate", "runtime": "css", "duration": "base", "easing": "emphasized", "reducedMotionFallback": "remove", "keyboardEquivalent": true, "rationale": "A small lift and a light that follows the pointer confirm which card is under the cursor; cards are not links, so nothing is hover-only.", "status": "verified" },
    { "id": "cta-magnetic", "surface": "marketing", "target": "Primary call to action", "intent": "delight", "trigger": "hover", "frequency": "rare", "properties": ["transform"], "interruptible": true, "decision": "animate", "runtime": "gsap", "duration": "base", "easing": "standard", "reducedMotionFallback": "remove", "keyboardEquivalent": true, "rationale": "A slight pull toward a fine pointer on the one primary action of the page; touch and keyboard users get the plain button.", "status": "verified" },
    { "id": "theme-change", "surface": "marketing", "target": "Whole page on scheme toggle", "intent": "continuity", "trigger": "state-change", "frequency": "rare", "properties": ["opacity"], "interruptible": false, "decision": "animate", "runtime": "view-transitions", "duration": "slow", "easing": "standard", "reducedMotionFallback": "remove", "keyboardEquivalent": true, "rationale": "A cross-fade between day and night schemes avoids a flash and echoes the brand idea.", "status": "verified" },
    { "id": "nav-anchor-scroll", "surface": "marketing", "target": "In-page navigation", "intent": "orientation", "trigger": "press", "frequency": "occasional", "decision": "none", "rationale": "Left to the browser's own smooth scrolling, which already honours reduced motion.", "status": "verified" },
    { "id": "portal-page-change", "surface": "application", "target": "Routed page content", "intent": "continuity", "trigger": "route-change", "frequency": "frequent", "properties": ["transform", "opacity"], "interruptible": true, "decision": "animate", "runtime": "motion", "duration": "fast", "easing": "standard", "reducedMotionFallback": "crossfade", "keyboardEquivalent": true, "rationale": "A fast fade and ten-pixel rise marks the change of section without delaying it.", "status": "verified" },
    { "id": "portal-figures", "surface": "application", "target": "Stat figures", "intent": "status", "trigger": "data-update", "frequency": "frequent", "properties": ["opacity"], "interruptible": true, "decision": "animate", "runtime": "motion", "duration": "spring", "easing": "spring", "reducedMotionFallback": "remove", "keyboardEquivalent": true, "rationale": "Numbers travel to their new value on the brand spring so a change is noticed, not missed.", "status": "verified" },
    { "id": "portal-chart-cursor", "surface": "application", "target": "Chart cursor and sun marker", "intent": "feedback", "trigger": "state-change", "frequency": "frequent", "properties": ["transform"], "interruptible": true, "decision": "animate", "runtime": "motion", "duration": "spring", "easing": "spring", "reducedMotionFallback": "remove", "keyboardEquivalent": true, "rationale": "The marker follows the time slider on a spring; the slider itself is a native range input.", "status": "verified" },
    { "id": "portal-series", "surface": "application", "target": "Chart series entering and leaving", "intent": "continuity", "trigger": "state-change", "frequency": "occasional", "properties": ["opacity"], "interruptible": true, "decision": "animate", "runtime": "motion", "duration": "slow", "easing": "standard", "reducedMotionFallback": "remove", "keyboardEquivalent": true, "rationale": "Opacity only: composited, so toggling a series costs no layout or paint.", "status": "verified" },
    { "id": "portal-disclosure", "surface": "application", "target": "Device details and conditional form fields", "intent": "continuity", "trigger": "press", "frequency": "occasional", "properties": ["opacity", "layout"], "interruptible": true, "decision": "animate", "runtime": "motion", "duration": "base", "easing": "standard", "reducedMotionFallback": "remove", "keyboardEquivalent": true, "rationale": "Height and opacity show where the new content came from.", "status": "verified" },
    { "id": "portal-table-sort", "surface": "application", "target": "History table rows on sort and paging", "intent": "feedback", "trigger": "press", "frequency": "frequent", "decision": "none", "rationale": "Reordering rows with animation slows scanning; the sort arrow and aria-sort state report the change.", "status": "verified" },
    { "id": "portal-typing", "surface": "application", "target": "Filter results while typing", "intent": "feedback", "trigger": "state-change", "frequency": "constant", "decision": "none", "rationale": "Seen on every keystroke; results update immediately.", "status": "verified" },
    { "id": "portal-loading", "surface": "application", "target": "Skeleton placeholders", "intent": "status", "trigger": "load", "frequency": "frequent", "properties": ["opacity"], "interruptible": true, "decision": "animate", "runtime": "css", "duration": "fast", "easing": "linear", "reducedMotionFallback": "remove", "keyboardEquivalent": true, "rationale": "A slow shimmer says the page is working; it stops under reduced motion.", "status": "verified" },
    { "id": "app-dial", "surface": "mobile", "target": "Sun and battery ring on the day arc dial", "intent": "status", "trigger": "data-update", "frequency": "frequent", "properties": ["transform"], "interruptible": true, "decision": "animate", "runtime": "reanimated", "duration": "spring", "easing": "spring", "reducedMotionFallback": "remove", "keyboardEquivalent": true, "rationale": "The signature on the phone: the sun and ring move on the brand spring on the UI thread when time or level changes.", "status": "verified" },
    { "id": "app-onboarding-pager", "surface": "mobile", "target": "Onboarding pages", "intent": "orientation", "trigger": "drag", "frequency": "once", "properties": ["transform"], "interruptible": true, "gestureDriven": true, "decision": "animate", "runtime": "reanimated", "duration": "spring", "easing": "spring", "reducedMotionFallback": "crossfade", "keyboardEquivalent": true, "rationale": "Pages track the finger and settle with a spring; the Next button does the same with one tap.", "status": "verified" },
    { "id": "app-reserve-slider", "surface": "mobile", "target": "Backup reserve slider", "intent": "feedback", "trigger": "drag", "frequency": "occasional", "properties": ["transform"], "interruptible": true, "gestureDriven": true, "decision": "animate", "runtime": "reanimated", "duration": "spring", "easing": "spring", "reducedMotionFallback": "remove", "keyboardEquivalent": true, "rationale": "The thumb follows the finger on the UI thread; plus and minus buttons and accessibility actions are the alternatives.", "status": "verified" },
    { "id": "app-list-enter", "surface": "mobile", "target": "Tiles and device rows", "intent": "orientation", "trigger": "load", "frequency": "occasional", "properties": ["transform", "opacity"], "interruptible": false, "decision": "animate", "runtime": "reanimated", "duration": "base", "easing": "enter", "reducedMotionFallback": "remove", "keyboardEquivalent": true, "rationale": "A short staggered entrance when a screen first mounts.", "status": "verified" },
    { "id": "app-tab-switch", "surface": "mobile", "target": "Tab bar", "intent": "continuity", "trigger": "press", "frequency": "frequent", "decision": "none", "rationale": "Platform tab behaviour is left untouched.", "status": "verified" },
    { "id": "scene-camera", "surface": "3d", "target": "Camera choreography", "intent": "storytelling", "trigger": "scroll", "frequency": "once", "properties": ["camera"], "interruptible": true, "decision": "animate", "runtime": "three", "duration": "scrubbed", "easing": "linear", "reducedMotionFallback": "static-composition", "keyboardEquivalent": true, "rationale": "Scroll moves the camera through three shots; the person can take over by dragging or with arrow keys at any time.", "status": "verified" },
    { "id": "scene-finish", "surface": "3d", "target": "Product material on finish change", "intent": "feedback", "trigger": "state-change", "frequency": "occasional", "properties": ["material"], "interruptible": true, "decision": "animate", "runtime": "three", "duration": "slow", "easing": "standard", "reducedMotionFallback": "remove", "keyboardEquivalent": true, "rationale": "The colour travels to the new finish so the change reads as the same object.", "status": "verified" },
    { "id": "scene-idle-rotation", "surface": "3d", "target": "Product auto-rotation", "intent": "delight", "trigger": "load", "frequency": "frequent", "decision": "none", "rationale": "Continuous rotation would render every frame for no purpose; the scene renders only when something changes.", "status": "verified" }
  ]
}

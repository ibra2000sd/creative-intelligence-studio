  "project": {
    "id": "haldora-launch",
    "name": "Haldora launch",
    "client": "Haldora"
  },
  "identity": {
    "name": "Haldora",
    "tagline": "Your home's energy, from sunrise to night",
    "positioning": "Haldora is the home battery that explains itself: it shows a household where its energy goes across the day and quietly makes the better choice.",
    "personality": [
      "calm",
      "warm",
      "plain-spoken",
      "quietly clever"
    ],
    "audience": [
      "Homeowners with rooftop solar",
      "Existing Haldora customers",
      "Arabic-speaking households in the Gulf"
    ],
    "voice": {
      "tone": [
        "plain",
        "warm",
        "specific"
      ],
      "rules": [
        "Say what happens in the home, then the number.",
        "Use times of day before technical terms.",
        "One idea per sentence."
      ],
      "prohibited": [
        "Fear of outages as a selling point",
        "Jargon without a plain explanation",
        "Superlatives that cannot be shown"
      ]
    }
  },
  "direction": {
    "id": "daylight-ledger",
    "title": "Daylight Ledger",
    "rationale": "Homeowners think about energy in terms of their day, not in kilowatts. A warm editorial language separates Haldora from both the industrial and the gadget ends of its category, and the day arc gives every deliverable one shared idea.",
    "emotionalIntent": "Calm confidence: the feeling of a house that is taken care of.",
    "principles": [
      "Tell it as a day.",
      "Warm grounds, one deep colour, one bright one.",
      "Numbers are set in mono and always have a plain-language label.",
      "Motion moves like light, never like machinery."
    ],
    "approvedPatterns": [
      "The day arc with the sun positioned by time",
      "Layered horizon landscapes",
      "Large serif statements with generous margins"
    ],
    "prohibitedPatterns": [
      "Green-on-black dashboards",
      "Glossy gadget renders on white",
      "Neon glows and lens flares",
      "Stock photography of smiling families"
    ],
    "signature": "The day arc: a sun on a dashed arc above a horizon, positioned by the time of day. It is the logo, the scroll story, the chart, the app dial and the light on the product.",
    "usabilityImplications": [
      "Time-of-day colour never carries meaning alone; every state has a label.",
      "Amber is a fill and mark colour, never text on paper."
    ],
    "technicalRequirements": [
      "Scroll-linked timeline on the marketing page",
      "Light and dark schemes mapped to day and night",
      "Arabic typeface with a matching weight range"
    ]
  },

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://creative-intelligence-studio.dev/schemas/experience-dna/1.0.0",
  "title": "Experience DNA",
  "description": "The single source of truth for a project's creative language. Every production engine reads from it; none of them may override it.",
  "type": "object",
  "required": ["schemaVersion", "revision", "status", "project", "identity", "direction", "color", "typography", "layout", "iconography", "imagery", "materials", "motion", "materials3d", "accessibility", "responsive", "localization", "evidence"],
  "additionalProperties": false,
  "$defs": {
    "hex": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "bezier": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number", "minimum": -2, "maximum": 2 } },
    "ms": { "type": "integer", "minimum": 0, "maximum": 4000 },
    "font": {
      "type": "object",
      "required": ["family", "fallback", "source", "license"],
      "additionalProperties": false,
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "fallback": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "description": "Where the font files come from, e.g. an npm package or a foundry." },
        "license": { "type": "string", "minLength": 2 },
        "weights": { "type": "array", "items": { "type": "integer", "minimum": 100, "maximum": 900 } },
        "variable": { "type": "boolean" }
      }
    },
    "semantic": {
      "type": "object",
      "required": ["bg", "surface", "surfaceRaised", "text", "textMuted", "primary", "onPrimary", "accent", "onAccent", "border", "focus", "success", "warning", "danger"],
      "additionalProperties": false,
      "properties": {
        "bg": { "$ref": "#/$defs/hex" },
        "surface": { "$ref": "#/$defs/hex" },
        "surfaceRaised": { "$ref": "#/$defs/hex" },
        "text": { "$ref": "#/$defs/hex" },
        "textMuted": { "$ref": "#/$defs/hex" },
        "primary": { "$ref": "#/$defs/hex" },
        "onPrimary": { "$ref": "#/$defs/hex" },
        "accent": { "$ref": "#/$defs/hex" },
        "onAccent": { "$ref": "#/$defs/hex" },
        "border": { "$ref": "#/$defs/hex" },
        "focus": { "$ref": "#/$defs/hex" },
        "success": { "$ref": "#/$defs/hex" },
        "warning": { "$ref": "#/$defs/hex" },
        "danger": { "$ref": "#/$defs/hex" }
      }
    }
  },
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "revision": { "type": "integer", "minimum": 1, "description": "Monotonic. Bumped by `creative-studio dna bump`; every revision is archived." },
    "status": { "enum": ["draft", "proposed", "approved"] },
    "updatedAt": { "type": "string", "format": "date-time" },
    "project": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "client": { "type": "string" } }
    },
    "identity": {
      "type": "object",
      "required": ["name", "positioning", "personality", "audience", "voice"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "tagline": { "type": "string" },
        "positioning": { "type": "string", "minLength": 20 },
        "personality": { "type": "array", "minItems": 2, "maxItems": 6, "uniqueItems": true, "items": { "type": "string" } },
        "audience": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "voice": {
          "type": "object",
          "required": ["tone", "rules"],
          "additionalProperties": false,
          "properties": {
            "tone": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "rules": { "type": "array", "items": { "type": "string" } },
            "prohibited": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "direction": {
      "type": "object",
      "required": ["id", "title", "rationale", "emotionalIntent", "principles", "prohibitedPatterns", "signature"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "rationale": { "type": "string", "minLength": 40, "description": "Why this direction fits this client and not any other." },
        "emotionalIntent": { "type": "string" },
        "principles": { "type": "array", "minItems": 2, "items": { "type": "string" } },
        "approvedPatterns": { "type": "array", "items": { "type": "string" } },
        "prohibitedPatterns": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "signature": { "type": "string", "description": "The one memorable device that recurs across every deliverable." },
        "usabilityImplications": { "type": "array", "items": { "type": "string" } },
        "technicalRequirements": { "type": "array", "items": { "type": "string" } }
      }
    },
    "color": {
      "type": "object",
      "required": ["palette", "semantic", "dataViz"],
      "additionalProperties": false,
      "properties": {
        "palette": {
          "type": "object",
          "minProperties": 3,
          "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
          "additionalProperties": {
            "type": "object",
            "required": ["hex", "role"],
            "additionalProperties": false,
            "properties": { "hex": { "$ref": "#/$defs/hex" }, "role": { "type": "string" }, "name": { "type": "string" } }
          }
        },
        "semantic": {
          "type": "object",
          "required": ["light", "dark"],
          "additionalProperties": false,
          "properties": { "light": { "$ref": "#/$defs/semantic" }, "dark": { "$ref": "#/$defs/semantic" } }
        },
        "defaultScheme": { "enum": ["light", "dark"] },
        "dataViz": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/hex" } }
      }
    },
    "typography": {
      "type": "object",
      "required": ["display", "text", "scale"],
      "additionalProperties": false,
      "properties": {
        "display": { "$ref": "#/$defs/font" },
        "text": { "$ref": "#/$defs/font" },
        "mono": { "$ref": "#/$defs/font" },
        "arabic": { "$ref": "#/$defs/font" },
        "scale": {
          "type": "object",
          "required": ["basePx", "ratio"],
          "additionalProperties": false,
          "properties": {
            "basePx": { "type": "number", "minimum": 14, "maximum": 22 },
            "ratio": { "type": "number", "minimum": 1.067, "maximum": 1.618 },
            "displayTracking": { "type": "number", "minimum": -0.08, "maximum": 0.2 },
            "textLineHeight": { "type": "number", "minimum": 1.2, "maximum": 2 },
            "displayLineHeight": { "type": "number", "minimum": 0.9, "maximum": 1.4 }
          }
        }
      }
    },
    "layout": {
      "type": "object",
      "required": ["grammar", "grid", "spacingUnitPx", "radius", "density"],
      "additionalProperties": false,
      "properties": {
        "grammar": { "enum": ["editorial", "cinematic", "product-showcase", "conversion", "catalogue", "instrument"] },
        "grid": {
          "type": "object",
          "required": ["columns", "gutterPx", "maxWidthPx", "marginPx"],
          "additionalProperties": false,
          "properties": {
            "columns": { "type": "integer", "minimum": 4, "maximum": 16 },
            "gutterPx": { "type": "integer", "minimum": 8, "maximum": 64 },
            "maxWidthPx": { "type": "integer", "minimum": 960, "maximum": 1920 },
            "marginPx": { "type": "integer", "minimum": 12, "maximum": 160 }
          }
        },
        "spacingUnitPx": { "type": "integer", "minimum": 2, "maximum": 12 },
        "radius": {
          "type": "object",
          "required": ["sm", "md", "lg"],
          "additionalProperties": false,
          "properties": {
            "sm": { "type": "integer", "minimum": 0, "maximum": 48 },
            "md": { "type": "integer", "minimum": 0, "maximum": 64 },
            "lg": { "type": "integer", "minimum": 0, "maximum": 96 }
          }
        },
        "density": { "enum": ["airy", "regular", "compact"] }
      }
    },
    "iconography": {
      "type": "object",
      "required": ["style", "strokeWidth", "gridPx"],
      "additionalProperties": false,
      "properties": {
        "style": { "enum": ["outline", "duotone", "solid"] },
        "strokeWidth": { "type": "number", "minimum": 1, "maximum": 3 },
        "gridPx": { "type": "integer", "minimum": 16, "maximum": 48 },
        "terminals": { "enum": ["round", "butt", "square"] }
      }
    },
    "imagery": {
      "type": "object",
      "required": ["style", "composition", "motifs"],
      "additionalProperties": false,
      "properties": {
        "style": { "type": "string" },
        "photography": { "type": "string" },
        "composition": { "type": "string" },
        "motifs": { "type": "array", "minItems": 1, "items": { "enum": ["arc", "horizon", "contour", "grid", "orbit", "strata", "grain", "bloom"] } },
        "texture": { "enum": ["none", "paper-grain", "film-grain", "halftone"] },
        "prohibited": { "type": "array", "items": { "type": "string" } }
      }
    },
    "materials": {
      "type": "object",
      "required": ["surface", "elevation"],
      "additionalProperties": false,
      "properties": {
        "surface": { "type": "string" },
        "lighting": { "type": "string" },
        "elevation": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["level", "shadow"],
            "additionalProperties": false,
            "properties": { "level": { "type": "integer", "minimum": 0, "maximum": 5 }, "shadow": { "type": "string" } }
          }
        }
      }
    },
    "motion": {
      "type": "object",
      "required": ["personality", "intensity", "durations", "easings", "spring", "stagger", "reducedMotion"],
      "additionalProperties": false,
      "properties": {
        "personality": { "type": "string" },
        "intensity": { "enum": ["none", "subtle", "balanced", "expressive"] },
        "durations": {
          "type": "object",
          "required": ["instant", "fast", "base", "slow", "cinematic"],
          "additionalProperties": false,
          "properties": {
            "instant": { "$ref": "#/$defs/ms" },
            "fast": { "$ref": "#/$defs/ms" },
            "base": { "$ref": "#/$defs/ms" },
            "slow": { "$ref": "#/$defs/ms" },
            "cinematic": { "$ref": "#/$defs/ms" }
          }
        },
        "easings": {
          "type": "object",
          "required": ["standard", "enter", "exit", "emphasized"],
          "additionalProperties": false,
          "properties": {
            "standard": { "$ref": "#/$defs/bezier" },
            "enter": { "$ref": "#/$defs/bezier" },
            "exit": { "$ref": "#/$defs/bezier" },
            "emphasized": { "$ref": "#/$defs/bezier" }
          }
        },
        "spring": {
          "type": "object",
          "required": ["stiffness", "damping", "mass"],
          "additionalProperties": false,
          "properties": {
            "stiffness": { "type": "number", "minimum": 10, "maximum": 1000 },
            "damping": { "type": "number", "minimum": 1, "maximum": 100 },
            "mass": { "type": "number", "minimum": 0.1, "maximum": 10 }
          }
        },
        "stagger": { "$ref": "#/$defs/ms" },
        "reducedMotion": { "enum": ["remove", "crossfade", "static-composition"] },
        "prohibited": { "type": "array", "items": { "type": "string" } }
      }
    },
    "materials3d": {
      "type": "object",
      "required": ["finishes", "environment"],
      "additionalProperties": false,
      "properties": {
        "finishes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "name", "baseColor", "metalness", "roughness"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "name": { "type": "string" },
              "baseColor": { "$ref": "#/$defs/hex" },
              "metalness": { "type": "number", "minimum": 0, "maximum": 1 },
              "roughness": { "type": "number", "minimum": 0, "maximum": 1 },
              "accent": { "$ref": "#/$defs/hex" }
            }
          }
        },
        "environment": {
          "type": "object",
          "required": ["keyLight", "fillLight", "background"],
          "additionalProperties": false,
          "properties": {
            "keyLight": { "$ref": "#/$defs/hex" },
            "fillLight": { "$ref": "#/$defs/hex" },
            "background": { "$ref": "#/$defs/hex" },
            "exposure": { "type": "number", "minimum": 0.2, "maximum": 3 }
          }
        }
      }
    },
    "accessibility": {
      "type": "object",
      "required": ["target", "minTextContrast", "minTargetPx"],
      "additionalProperties": false,
      "properties": {
        "target": { "enum": ["WCAG 2.2 A", "WCAG 2.2 AA", "WCAG 2.2 AAA"] },
        "minTextContrast": { "type": "number", "minimum": 3, "maximum": 21 },
        "minTargetPx": { "type": "integer", "minimum": 24, "maximum": 64 },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "responsive": {
      "type": "object",
      "required": ["breakpointsPx"],
      "additionalProperties": false,
      "properties": {
        "breakpointsPx": {
          "type": "object",
          "required": ["sm", "md", "lg", "xl"],
          "additionalProperties": false,
          "properties": {
            "sm": { "type": "integer" },
            "md": { "type": "integer" },
            "lg": { "type": "integer" },
            "xl": { "type": "integer" }
          }
        },
        "strategy": { "type": "string" }
      }
    },
    "localization": {
      "type": "object",
      "required": ["defaultLocale", "locales", "rtl"],
      "additionalProperties": false,
      "properties": {
        "defaultLocale": { "type": "string" },
        "locales": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "rtl": { "type": "boolean" },
        "numerals": { "enum": ["latin", "locale"] },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "platformExceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["platform", "rule", "reason"],
        "additionalProperties": false,
        "properties": { "platform": { "enum": ["web", "ios", "android", "print", "3d"] }, "rule": { "type": "string" }, "reason": { "type": "string" } }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["field", "source"],
        "additionalProperties": false,
        "properties": {
          "field": { "type": "string" },
          "source": { "enum": ["client", "contract", "research", "creative-proposal"] },
          "note": { "type": "string" }
        }
      }
    }
  }
}

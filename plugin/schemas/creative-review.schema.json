{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://creative-intelligence-studio.dev/schemas/creative-review/1.0.0",
  "title": "Creative Review",
  "description": "A structured evaluation by a reviewer that did not produce the work. It is an opinion with reasons, not proof of quality and not client approval.",
  "type": "object",
  "required": ["schemaVersion", "reviewer", "independent", "evaluationOnly", "reviewedAt", "subject", "criteria", "findings", "recommendation"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "reviewer": { "type": "string", "minLength": 1 },
    "independent": { "type": "boolean", "description": "True only if the reviewer did not author the work under review." },
    "evaluationOnly": { "const": true },
    "reviewedAt": { "type": "string", "format": "date-time" },
    "subject": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "evidenceViewed": { "type": "array", "items": { "type": "string" } },
    "criteria": {
      "type": "object",
      "required": ["designCoherence", "brandAlignment", "visualHierarchy", "typography", "originality", "motionQuality", "interactionClarity", "assetQuality", "presentationPolish", "professionalReadiness"],
      "additionalProperties": false,
      "patternProperties": {
        "^[a-zA-Z]+$": {
          "type": "object",
          "required": ["score", "reason"],
          "additionalProperties": false,
          "properties": {
            "score": { "type": "integer", "minimum": 1, "maximum": 5 },
            "reason": { "type": "string", "minLength": 15 },
            "notAssessed": { "type": "boolean" }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "where", "issue"],
        "additionalProperties": false,
        "properties": {
          "severity": { "enum": ["blocker", "major", "minor", "note"] },
          "where": { "type": "string" },
          "issue": { "type": "string" },
          "suggestion": { "type": "string" }
        }
      }
    },
    "recommendation": { "enum": ["ready-for-client", "revise", "rework"] }
  }
}
